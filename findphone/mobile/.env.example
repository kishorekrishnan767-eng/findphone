# Copy to .env and fill in. Passed at build time:
#   flutter run --dart-define-from-file=.env
# Values are compiled in, so they are available in the background-service isolate too.
# Firebase client config is an identifier, not a secret; access is enforced by rules + App Check.

# --- Firebase (Project settings > Your apps) ---
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=com.findphone.app

# --- Local development ---
# true = use the Firestore + Auth emulators (npm run emulators). App Check is skipped.
USE_EMULATORS=false
# 10.0.2.2 = host machine from the Android emulator; use your LAN IP for a physical phone.
EMULATOR_HOST=10.0.2.2

# --- App Check (docs/firebase-setup.md §5) ---
# Debug builds only: a UUID registered under App Check > Apps > Android > Manage debug tokens.
# Leave empty to use Play Integrity. Release builds always use Play Integrity / App Attest.
APP_CHECK_DEBUG_TOKEN=

# --- Product ---
TERMS_VERSION=1.0
PRIVACY_URL=https://your-project-id.web.app/privacy
WEB_LOOKUP_URL=https://your-project-id.web.app

# --- Tracking (docs/architecture.md §3.4). Out-of-range values fall back to defaults. ---
# Foreground sampling interval, 5-60 s
TRACKING_FG_INTERVAL_SECONDS=15
# Max seconds between writes while in the foreground, 30-110 (must stay under the web's 120 s Live window)
TRACKING_FG_HEARTBEAT_SECONDS=60
# Background sampling and heartbeat interval, 120-900 s
TRACKING_BG_INTERVAL_SECONDS=300
# Movement that counts as a change, 10-200 m
TRACKING_DISTANCE_FILTER_METERS=25
# Battery change that triggers a write, 1-20 points
TRACKING_BATTERY_DELTA=5
