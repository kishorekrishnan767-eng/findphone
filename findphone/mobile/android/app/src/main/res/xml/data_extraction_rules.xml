<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: no cloud backup or device transfer of app data. The recovery secret lives in
     Keystore-encrypted storage, which can't be restored on another device anyway, and the
     registration should not silently reappear elsewhere. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
