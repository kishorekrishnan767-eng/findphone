# Copy to .env (or .env.local) and fill in. Vite exposes only VITE_* variables to the browser.
# The Firebase web config is an identifier, not a secret; access is enforced by rules + App Check.

# --- Firebase (Project settings > Your apps > Web) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=

# --- App Check (docs/firebase-setup.md §5) ---
# reCAPTCHA v3 site key. Empty = App Check off (only acceptable with the emulators).
VITE_RECAPTCHA_V3_SITE_KEY=
# Development only: a UUID registered under App Check > Apps > Web > Manage debug tokens.
# Put it in .env.local (git-ignored). Ignored in production builds.
VITE_APP_CHECK_DEBUG_TOKEN=

# --- Local development ---
# true = read from the Firestore emulator (npm run emulators). No Firebase project needed.
VITE_USE_EMULATORS=false
VITE_EMULATOR_HOST=localhost

# --- Product ---
# A device counts as Live when its last fix is younger than this (30-600). Keep above the
# mobile TRACKING_FG_HEARTBEAT_SECONDS.
VITE_LIVE_THRESHOLD_SECONDS=120
# Client-side cooldown: searches allowed per rolling minute (1-60).
VITE_SEARCH_LIMIT_PER_MINUTE=10
# Country pre-selected in the number field (ISO code from shared/countries.json).
VITE_DEFAULT_COUNTRY=IN

# --- Map ---
# Standard styles: OpenFreeMap, no key or billing needed.
VITE_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
VITE_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
# Optional: a free MapTiler key enables the satellite toggle. Restrict it to your domains in MapTiler.
VITE_MAPTILER_KEY=
